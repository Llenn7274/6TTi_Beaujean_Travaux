<Window x:Class="_6TTi_Beaujean_Act3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6TTi_Beaujean_Act3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#FFDAA7F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Exemple Multipage" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" FontWeight="Bold"/>
            <StackPanel Grid.Column="1">
                <Button x:Name="Page1Button" Content="Page 1" FontWeight="Black" FontSize="30" Width="400" Height="73" Background="#FFE67070"/>
                <Button x:Name="Page2Button" Content="Page 2" FontWeight="Black" FontSize="30" Width="400" Height="73" Background="#FF7D7DF0"/>
            </StackPanel>
        </Grid>
        <Frame x:Name="mainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
