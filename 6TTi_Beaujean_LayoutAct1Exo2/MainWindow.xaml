<Window x:Class="_6TTi_Beaujean_LayoutAct1Exo2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6TTi_Beaujean_LayoutAct1Exo2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="350">
    <Grid Background="#FF73B5DA">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="" Margin="10" Background="White" Height="60" Width="250"/>
            <Button Content="C" Margin="10" Background="Red" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="1" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="2" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="3" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="+" Margin="15,10,10,10" Background="DarkGreen" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button Content="4" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="5" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="6" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="-" Margin="15,10,10,10" Background="DarkGreen"  Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button Content="7" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="8" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="9" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="/" Margin="15,10,10,10" Background="DarkGreen"  Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Content="," Margin="15,10,10,10" Background="#FF7AD2EE" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="0" Margin="15,10,10,10" Background="#FF68FA54" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="*" Margin="15,10,10,10" Background="DarkGreen"  Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
            <Button Content="=" Margin="15,10,10,10" Background="yellow" Height="60" Width="60" FontSize="30" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
