<Window x:Class="_6TTi_Beaujean_WpfAct2Events1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6TTi_Beaujean_WpfAct2Events1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="300">
    <Grid Background="DarkGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="txtBlockA" Text="A" VerticalAlignment="Center" FontWeight="Bold" FontSize="50" Margin="10,5,20,5"/>
            <TextBox x:Name="txtA" Width="175" Height="50" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="txtBlockB" Text="B" VerticalAlignment="Center" FontWeight="Bold" FontSize="50" Margin="10,5,20,5"/>
            <TextBox x:Name="txtB" Width="175" Height="50" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="txtBlockC" Text="C" VerticalAlignment="Center" FontWeight="Bold" FontSize="50" Margin="10,5,20,5"/>
            <TextBox x:Name="txtC" Width="175" Height="50" Margin="5"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="btnCalculer" Content="Calculer" Width="200" Height="90" Margin="5" Click="btnCalculer_Click" FontSize="50" FontWeight="Black"/>
            <Button x:Name="btnV" Content="V" Width="50" Height="90" Margin="5" Click="btnCalculer_Click" FontSize="50" FontWeight="Black"/>
        </StackPanel>
    </Grid>
</Window>
