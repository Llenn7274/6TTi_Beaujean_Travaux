<Window x:Class="_6TTi_Beaujean_ACT1Ex1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6TTi_Beaujean_ACT1Ex1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" Background="Yellow">
            <Button Content="Button 1" Height="100"/>
            <Button Content="Button 1" Height="100"/>
        </StackPanel>
        <DockPanel Grid.Column="1">
            <Button DockPanel.Dock="Top" Content="Top" Height="50"/>
            <Button DockPanel.Dock="Bottom" Content="Bottom" Height="50"/>
            <Button DockPanel.Dock="Left" Content="Left" Width="50"/>
            <Button DockPanel.Dock="Right" Content="Right" Width="50"/>
            <Button Content="Center"/>
        </DockPanel>

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="1" HorizontalAlignment="center" VerticalAlignment="Center"  Background="Pink">
            <Button Content="Button 1" Width="90"/>
            <Button Content="Button 2" Width="90"/>
            <Button Content="Button 3" Width="90"/>
            <Button Content="Button 4" Width="90" Height="100"/>
            <Button Content="Button 5" Width="90"/>
            <Button Content="Button 6" Width="90"/>
        </WrapPanel>
        <Canvas Grid.Column="1" Background="Coral" Margin="0,217,0,0" Grid.RowSpan="2">
            <Ellipse Fill="Black" Height="150" Canvas.Left="100" Stroke="white" Canvas.Top="25" Width="150"/>
            <Ellipse Fill="Yellow" Height="100" Canvas.Left="125" Stroke="yellow" Canvas.Top="50" Width="100" />
            <Ellipse Fill="red" Height="50" Canvas.Left="150" Stroke="red" Canvas.Top="75" Width="50" />
        </Canvas>
    </Grid>
</Window>
